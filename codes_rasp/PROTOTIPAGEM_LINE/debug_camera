import cv2
import time

cap = cv2.VideoCapture(2)

if not cap.isOpened():
    print("Erro ao abrir a c�mera.")
    exit()

inicio = time.time()

while True:
    ret, frame = cap.read()

    if not ret:
        print("Erro ao ler frame.")
        break

    # Mostra o frame da c�mera
    cv2.imshow("Camera", frame)

    # Atualiza a janela
    cv2.waitKey(1)

    # Fecha ap�s 3 segundos
    if time.time() - inicio > 3:
        break

cap.release()
cv2.destroyAllWindows()

print("Fim do teste.")